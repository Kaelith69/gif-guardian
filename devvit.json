{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "gif-guardian",
  "dev": {
    "subreddit": "TestEnvironmentAlpha"
  },
  "server": {},
  "menu": {
    "items": [
      {
        "label": "Gif-Guardian: Restrict GIF",
        "description": "Restrict this GIF and remove the comment as spam.",
        "location": "comment",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/restrict-gif"
      },
      {
        "label": "Gif-Guardian: Manage Restricted GIFs",
        "description": "Disable or restore restricted GIFs.",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/manage-restricted-gifs"
      },
      {
        "label": "Gif-Guardian: Sync AutoModerator",
        "description": "Reconcile AutoModerator with the GIF registry.",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/sync-automod"
      }
    ]
  },
  "forms": {
    "restrictGif": "/internal/form/restrict-gif-submit",
    "manageRestrictedGifs": "/internal/form/manage-restricted-gifs-submit"
  },
  "triggers": {
    "onCommentDelete": "/internal/triggers/comment-delete",
    "onPostDelete": "/internal/triggers/post-delete"
  },
  "permissions": {
    "redis": true,
    "reddit": {
      "enable": true,
      "scope": "moderator"
    }
  }
}
